%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a100951605744ab5a908f8be9ae55ef, type: 3}
  m_Name: Default
  m_EditorClassIdentifier: Assembly-CSharp::PlantSettings
  growingEnd: 0
  growingDuration: 20
  enableFlowering: 1
  floweringEnd: 0
  floweringDuration: 10
  enableFruiting: 1
  fruitingEnd: 0
  fruitingDuration: 10
  development: 1
  lsAxiom: A(0, 0)
  lsRules: '# tip A(s, o): has grown s units on an axis of branching order o (0 =
    main stem)

    A(s, o) : s < maxLen * ratio**o and o < maxOrder -> F(dl) /(137.5)
    [ &(branchAngle) A(0, o+1) ] A(s+dl, o) @ pBranch

    A(s, o) : s < maxLen *
    ratio**o -> F(dl) /(137.5) [ &(leafAngle) L ] A(s+dl, o) @ pLeaf

    A(s, o)
    : s < maxLen * ratio**o -> F(dl) A(s+dl, o) @ max(0, 1 - pBranch - pLeaf)

    #
    at its length limit the tip ends: with a flower bud, or without

    A(s, o)
    : s >= maxLen * ratio**o -> K @ pFlower

    A(s, o) : s >= maxLen * ratio**o
    -> @ 1 - pFlower'
  lsConstants:
  - name: maxLen
    value: 15
    min: 1
    max: 40
  - name: ratio
    value: 0.5
    min: 0.1
    max: 1
  - name: maxOrder
    value: 3
    min: 0
    max: 6
  - name: dl
    value: 0.4
    min: 0.1
    max: 2
  - name: pBranch
    value: 0.15
    min: 0
    max: 1
  - name: pLeaf
    value: 0.6
    min: 0
    max: 1
  - name: pFlower
    value: 0.3
    min: 0
    max: 1
  - name: branchAngle
    value: 40
    min: 0
    max: 90
  - name: leafAngle
    value: 60
    min: 0
    max: 90
  lsUnit: 0.1
  lsAngle: 25
  leafSymbols: L
  flowerSymbols: K
  growthSpeed: 0.125
  maxLength: 2
  directionBias: 4
  perturbationStd: 0.7
  maxRadius: 0.08
  radiusDepthFactor: 0.65
  radiusFalloff: 1
  endTaperLength: 0.3
  radialGrowthTime: 8
  spawnStartFraction: 0.1
  spawnCheckInterval: 0.03
  spawnProbability: 0.8
  leafProbabilityAtEnd: 0.4
  phyllotaxisNoiseDeg: 10
  branchProbability: 0.15
  branchStartFraction: 0.2
  maxDepth: 3
  branchElevationDeg: 33
  sideBranchLengthRatio: 0.5
  lengthFalloff: 0.8
  leafPrefabs:
  - {fileID: 6210749114086206293, guid: 675e43d6d7aeb4be0a2371a5dddaa6f8, type: 3}
  leafGrowthDuration: 5
  maxLeafSize: 0.125
  leafSizeFalloff: 0.5
  leafSizeNoise: 0.2
  leafElevationDeg: -20
  flowerPrefabs:
  - {fileID: 4799451868281231511, guid: f991fc312701640c8a3e5cec039ce8f4, type: 3}
  flowerProbability: 0.65
  flowerDelay: 5
  budGrowDuration: 3
  flowerOpenDuration: 8
  maxFlowerSize: 0.5
  flowerSizeNoise: 0.1
  fruitSetProbability: 0.25
  fruitDevelopDuration: 6
  maxBranches: 200
  maxLeaves: 1500
  maxFlowers: 200
  obstacleClearance: 0.005
  leafMaxTiltDeg: 45
  flowerMaxTiltDeg: 30
  bendMoveSpeed: 0.025
  bendFlexibleRadius: 0.005
  bendSettleTime: 15
  witherWaveDuration: 30
  witherJitter: 2
  organWitherTime: 6
  stemWitherTime: 20
  stemWitheredRadiusFraction: 0.7
  witheredColor: {r: 0.42, g: 0.35, b: 0.2, a: 1}
  witherColorAmount: 0.85
