--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a100951605744ab5a908f8be9ae55ef, type: 3}
  m_Name: Bush_1
  m_EditorClassIdentifier: Assembly-CSharp::PlantSettings
  growingEnd: 0
  growingDuration: 60
  enableFlowering: 1
  floweringEnd: 0
  floweringDuration: 10
  enableFruiting: 1
  fruitingEnd: 0
  fruitingDuration: 10
  development: 1
  lsAxiom: X(steps)
  lsRules: '# bracketed plant (The Algorithmic Beauty of Plants, Fig. 1.24 f) without
    elongation:

    # X(n) has n steps left; its segments get the length they would
    reach by doubling n-1 more times (F -> F F)

    X(n) : n > 0 -> F(startLen*(1+lenFactor*(n-1)))
    [ + / /(30) X(n-1) ] F(startLen*(1 + lenFactor*(n-1))) [ - /(60) X(n-1) ] F(startLen*(1
    + (n-1))) X(n-1)

    # the twig ends: a leaf, sometimes a flower bud

    X(n)
    : n <= 0 -> [ &(leafAngle) L ] [ /(180) &(leafAngle) L ] @ 1 - pFlower

    X(n)
    : n <= 0 -> K @ pFlower'
  lsConstants:
  - name: steps
    value: 4.99
    min: 1
    max: 6
  - name: angle
    value: 15
    min: 0
    max: 60
  - name: roll
    value: 57.2
    min: 0
    max: 180
  - name: pFlower
    value: 0.2
    min: 0
    max: 1
  - name: startLen
    value: 1.79
    min: 0
    max: 10
  - name: lenFactor
    value: 0.564
    min: 0
    max: 1
  - name: leafAngle
    value: 133
    min: 0
    max: 180
  lsUnit: 0.035
  lsAngle: 25
  leafSymbols: L
  flowerSymbols: K
