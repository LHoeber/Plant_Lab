  m_Script: {fileID: 11500000, guid: 7662b6942340249b5bb444d7f0d3d845, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LSystemPreview
  fromSettings: {fileID: 11400000, guid: 3c6bf430402f748a287adb38d3e97d65, type: 2}
  axiom: A(0, 0)
  rules: 'A(s, o) : s < maxLen * ratio**o and o < maxOrder -> F(dl) [ &(40) A(1,
    o+1) ] /(17.5) A(s+dl, o) @ pBranch

    A(s, o) : s < maxLen * ratio**o -> F(dl)
    A(s+dl, o) @ 1 - pBranch

    A(s, o) : s >= maxLen * ratio**o -> O(o)'
  constants:
  - name: maxLen
    value: 4
    min: 0.5
    max: 10
  - name: ratio
    value: 0.6
    min: 0.1
    max: 1
  - name: maxOrder
    value: 3
    min: 0
    max: 6
  - name: dl
    value: 0.25
    min: 0.05
    max: 1
  - name: pBranch
    value: 0.3
    min: 0
    max: 1
  cactusSegment: {fileID: 0}
  steps: 40
  seed: 0
  maxModules: 200000
  stepLength: 1
  angle: 25
  scale: 0.1
  depthColors:
    serializedVersion: 2
    key0: {r: 0.45, g: 0.3, b: 0.15, a: 1}
    key1: {r: 0.55, g: 0.75, b: 0.25, a: 1}
